        </div>
        <div style={{ display:'flex', gap:'7px', marginBottom:'.9rem', alignItems:'center', flexWrap:'wrap' }}>
          <input placeholder="Suche…" value={search} onChange={e => setSearch(e.target.value)} style={{ maxWidth:200 }}/>
