<div id="root"></div>

<script type="text/babel">
  const { useState, useEffect, useCallback, useRef, useMemo } = React;

  const RECIPES  = window.RECIPES  || [];
  const WORKOUTS = window.WORKOUTS || [];

  // ── PLAN-START & SPORT-KONSTANTEN ─────────────────────────────────────────
  const PLAN_START = new Date(2026, 3, 13); // Mo 13. April 2026

  // PPL-Schema: 0=So,1=Mo,2=Di,3=Mi,4=Do,5=Fr,6=Sa
  // Mo=Push, Mi=Pull, Fr=Legs, sonst Rest
  const DOW_TO_WORKOUT = {
    1: 'ppl_push',  // Montag
    3: 'ppl_pull',  // Mittwoch
    5: 'ppl_legs',  // Freitag
  };

  /** Liefert das Basis-Workout für ein bestimmtes Datum (ohne Verschiebungen). */
  function baseWorkoutForDate(dateObj) {
    const dow = dateObj.getDay(); // 0=So … 6=Sa
    const wid = DOW_TO_WORKOUT[dow];
    return WORKOUTS.find(w => w.id === (wid || 'rest')) || WORKOUTS.find(w => w.id === 'rest');
  }

  /**
   * Berechnet die Trainings-Phase basierend auf dem Plan-Startdatum.
   * Woche 1-2 → phase 1 (2 Sätze)
   * Woche 3-4 → phase 2 (Original)
   * Woche 5-6 → phase 3 (+1 Satz)
   */
  function getTrainingPhase(dateObj) {
    const msPerDay = 86400000;
    const daysDiff = Math.floor((dateObj - PLAN_START) / msPerDay);
    if (daysDiff < 0)  return 2; // vor Plan-Start → Original
    const week = Math.floor(daysDiff / 7) + 1;
    if (week <= 2) return 1;
    if (week <= 4) return 2;
    return 3;
  }

  /** Passt die Sätze eines Workouts an die Phase an. */
  function adjustedExercises(workout, phase) {
    return workout.exercises.map(ex => {
      let sets = ex.sets;
      if (phase === 1) sets = Math.min(sets, 2);
      if (phase === 3) sets = sets + 1;
      return { ...ex, sets };
    });
  }

  // ── PERSON & MAKROS ───────────────────────────────────────────────────────
  const PERSON = { gender: 'm', height: 190, weight: 85, age: 35, goalKg: 89 };

  function calcMacros(p) {
    const bmr = 88.362 + 13.397 * p.weight + 4.799 * p.height - 5.677 * p.age;
    const target = Math.round(bmr * 1.55) + 250;
    const protein = Math.round(p.weight * 1.7);
    const carbs   = Math.round(target * 0.35 / 4);
    const fat     = Math.round((target - protein * 4 - carbs * 4) / 9);
    const pp = Math.round(protein * 4 / target * 100);
    const cp = Math.round(carbs   * 4 / target * 100);
    const fp = 100 - pp - cp;
    return { kcal: target, protein, carbs, fat, pp, cp, fp };
  }

  // ── PLAN BUILDER ──────────────────────────────────────────────────────────
  function buildWeekPlan() {
    const plan = {};
    const bf = RECIPES.filter(r => r.type === 'breakfast');
    const lu = RECIPES.filter(r => r.type === 'lunch');
    const di = RECIPES.filter(r => r.type === 'dinner');
    if (!bf.length || !lu.length || !di.length) { console.error('RECIPES fehlt'); return plan; }
    for (let week = 0; week < 6; week++) {
      for (let day = 0; day < 7; day++) {
        const d = new Date(PLAN_START);
        d.setDate(d.getDate() + week * 7 + day);
        const key = dk(d);
        plan[key] = {
          breakfast: bf[(week * 7 + day)     % bf.length],
          lunch:     lu[(week * 7 + day + 2) % lu.length],
          dinner:    di[(week * 7 + day + 5) % di.length],
          eaten:        { breakfast: false, lunch: false, dinner: false },
          workout_id:   baseWorkoutForDate(d).id,  // Standard-Zuweisung
          workout_done: false,
        };
      }
    }
    return plan;
  }

  // ── HELPERS ───────────────────────────────────────────────────────────────
  function dk(d)  { return d instanceof Date ? d.toISOString().slice(0, 10) : d; }
  function fmt(v) { return typeof v === 'number' ? Math.round(v) : v; }
  function getMonday(d) {
    const c = new Date(d), day = c.getDay(), diff = c.getDate() - day + (day === 0 ? -6 : 1);
    c.setDate(diff); c.setHours(0, 0, 0, 0); return c;
  }
  function weekDates(mon) { return Array.from({length:7}, (_, i) => { const d = new Date(mon); d.setDate(d.getDate() + i); return d; }); }
  function getISOWeek(d) {
    const dt = new Date(d); dt.setHours(0,0,0,0);
    dt.setDate(dt.getDate() + 3 - (dt.getDay() + 6) % 7);
    const w1 = new Date(dt.getFullYear(), 0, 4);
    return 1 + Math.round(((dt - w1) / 86400000 - 3 + (w1.getDay() + 6) % 7) / 7);
  }
  function addDays(dateStr, n) {
    const d = new Date(dateStr); d.setDate(d.getDate() + n); return dk(d);
  }
  const DAYS   = ['Mo','Di','Mi','Do','Fr','Sa','So'];
  const MONTHS = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  const DAY_FULL = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];

  // ── SUPABASE ──────────────────────────────────────────────────────────────
  async function dbLoadPlan() {
    try {
      const { data, error } = await sb.from('calendar_days').select('*').eq('user_id', USER_ID);
      if (error || !data || !data.length) return null;
      const plan = buildWeekPlan();
      data.forEach(row => {
        const key = (row.date_key || '').slice(0, 10);
        if (!key || !plan[key]) return;
        plan[key].eaten = {
          breakfast: !!row.eaten?.breakfast,
          lunch:     !!row.eaten?.lunch,
          dinner:    !!row.eaten?.dinner,
        };
        plan[key].workout_done = !!row.workout_done;
        if (row.workout_id) plan[key].workout_id = row.workout_id;
        ['breakfast','lunch','dinner'].forEach(m => {
          const rid = row[m + '_id'];
          if (rid) { const r = RECIPES.find(x => x.id === rid); if (r) plan[key][m] = r; }
        });
      });
      return plan;
    } catch(e) { console.warn('dbLoadPlan:', e); return null; }
  }

  async function dbSaveDay(key, day) {
    try {
      await sb.from('calendar_days').upsert({
        user_id:      USER_ID,
        date_key:     key,
        breakfast_id: day.breakfast?.id || null,
        lunch_id:     day.lunch?.id     || null,
        dinner_id:    day.dinner?.id    || null,
        eaten:        { breakfast: !!day.eaten?.breakfast, lunch: !!day.eaten?.lunch, dinner: !!day.eaten?.dinner },
        workout_id:   day.workout_id   || null,
        workout_done: !!day.workout_done,
      }, { onConflict: 'user_id,date_key' });
    } catch(e) { console.warn('dbSaveDay:', e); }
  }

  async function dbLoadSupplements() {
    try {
      const { data } = await sb.from('electrolytes').select('*').eq('user_id', USER_ID);
      if (!data) return {};
      const obj = {};
      data.forEach(r => {
        const k = (r.date_key || '').slice(0, 10);
        obj[k + '_mg'] = !!r.magnesium; obj[k + '_k'] = !!r.kalium; obj[k + '_salt'] = !!r.natrium;
      });
      return obj;
    } catch(e) { return {}; }
  }

  async function dbSaveSupplement(dateKey, field, value) {
    try {
      const map = { mg: 'magnesium', k: 'kalium', salt: 'natrium' };
      await sb.from('electrolytes').upsert(
        { user_id: USER_ID, date_key: dateKey, [map[field]]: value },
        { onConflict: 'user_id,date_key' }
      );
    } catch(e) { console.warn('dbSaveSupplement:', e); }
  }

  async function dbLoadCustomRecipes() {
    try {
      const { data } = await sb.from('custom_recipes').select('*').eq('user_id', USER_ID);
      if (!data) return [];
      return data.map(r => ({ ...r.recipe_data, id: 'c' + r.id, supabase_id: r.id, custom: true }));
    } catch(e) { return []; }
  }
  async function dbSaveCustomRecipe(recipe) {
    try {
      const { data } = await sb.from('custom_recipes').insert({ user_id: USER_ID, recipe_data: recipe }).select().single();
      return data ? ('c' + data.id) : recipe.id;
    } catch(e) { return recipe.id; }
  }
  async function dbDeleteCustomRecipe(supabaseId) {
    try { await sb.from('custom_recipes').delete().eq('id', supabaseId).eq('user_id', USER_ID); }
    catch(e) {}
  }

  // ── SHARED UI ─────────────────────────────────────────────────────────────
  function ProgressBar({ value, max, color = 'var(--teal)', label, unit = 'g' }) {
    const pct  = Math.min(100, max > 0 ? (value / max) * 100 : 0);
    const over = value > max * 1.05;
    return (
      <div className="macro-row">
        <span className="macro-label">{label}</span>
        <div className="progress-bar" style={{flex:1}}>
          <div className="progress-fill" style={{ width: pct + '%', background: over ? '#ef4444' : color }}/>
        </div>
        <span className="macro-value" style={{ color: over ? '#c04444' : 'var(--txt2)' }}>
          {fmt(value)}/{max}{unit}
        </span>
      </div>
    );
  }

  function Snackbar({ msg, onClose }) {
    useEffect(() => { const t = setTimeout(onClose, 3200); return () => clearTimeout(t); }, []);
    return <div className="snack">{msg}</div>;
  }

  function LoadingScreen() {
    return (
      <div className="loading-overlay">
        <div className="spinner"/>
        <p style={{ color: 'var(--txt3)', fontSize: '.88rem' }}>Daten werden geladen…</p>
      </div>
    );
  }

  const TAG_COLORS = {
    pcos: ['badge-purple','🌸 PCOS'], lowgi: ['badge-green','📉 Low-GI'],
    protein: ['badge-teal','💪 Protein'], legumes: ['badge-amber','🫘 Hülsenf.'],
    batch: ['badge-blue','📦 Batch'], schnell: ['badge-teal','⚡ Schnell'],
    prep: ['badge-blue','🌙 Prep'], vegan: ['badge-green','🌱 Vegan'],
    muskelaufbau: ['badge-coral','🏋️ Aufbau'],
  };
  function TagBadge({ tag }) {
    const [cls, lbl] = TAG_COLORS[tag] || ['badge-amber', tag];
    return <span className={`badge ${cls}`}>{lbl}</span>;
  }

  // ── APP ───────────────────────────────────────────────────────────────────
  function App() {
    const [loading,     setLoading]     = useState(true);
    const [tab,         setTab]         = useState('dashboard');
    const [plan,        setPlan]        = useState({});
    const [customRecs,  setCustomRecs]  = useState([]);
    const [supplements, setSupplements] = useState({});
    const [batchMode,   setBatchMode]   = useState(false);
    const [curWeek,     setCurWeek]     = useState(() => getMonday(new Date()));
    const [shopWeek,    setShopWeek]    = useState(() => getMonday(new Date()));
    const [sportWeek,   setSportWeek]   = useState(() => getMonday(new Date()));
    const [snack,       setSnack]       = useState(null);
    const [modal,       setModal]       = useState(null);

    const macros     = useMemo(() => calcMacros(PERSON), []);
    const allRecipes = useMemo(() => [...RECIPES, ...customRecs], [customRecs]);

    useEffect(() => {
      (async () => {
        const [planData, supplData, recData] = await Promise.all([
          dbLoadPlan(), dbLoadSupplements(), dbLoadCustomRecipes(),
        ]);
        setPlan(planData || buildWeekPlan());
        setSupplements(supplData || {});
        setCustomRecs(recData || []);
        setLoading(false);
      })();
    }, []);

    const toast      = useCallback(msg => setSnack(msg), []);
    const todayKey   = dk(new Date());

    function dayMacros(dateK) {
      const day = plan[dateK];
      if (!day) return { kcal:0, carbs:0, protein:0, fat:0 };
      const t = { kcal:0, carbs:0, protein:0, fat:0 };
      ['breakfast','lunch','dinner'].forEach(m => {
        if (day.eaten[m] && day[m]) Object.keys(t).forEach(k => t[k] += (day[m].macros[k] || 0));
      });
      return t;
    }

    async function toggleEaten(dateK, meal) {
      setPlan(prev => {
        const np = { ...prev, [dateK]: { ...prev[dateK], eaten: { ...prev[dateK].eaten } } };
        np[dateK].eaten[meal] = !np[dateK].eaten[meal];
        dbSaveDay(dateK, np[dateK]);
        return np;
      });
    }

    async function updatePlanDay(dateK, updates) {
      setPlan(prev => {
        const np = { ...prev, [dateK]: { ...prev[dateK], ...updates } };
        dbSaveDay(dateK, np[dateK]);
        return np;
      });
    }

    async function toggleWorkoutDone(dateK) {
      setPlan(prev => {
        const np = { ...prev, [dateK]: { ...prev[dateK], workout_done: !prev[dateK].workout_done } };
        dbSaveDay(dateK, np[dateK]);
        return np;
      });
    }

    /**
     * Verschiebt ein Workout auf den Folgetag.
     * Die PPL-Reihenfolge wird dabei bewahrt: alle folgenden Trainingstage
     * der Woche rücken um einen Tag nach hinten.
     */
    function shiftWorkout(dateK) {
      const nextKey = addDays(dateK, 1);
      setPlan(prev => {
        if (!prev[nextKey]) { toast('⚠️ Kein Folgetag im Plan vorhanden.'); return prev; }
        const np = { ...prev };
        // Tausche workout_id zwischen heute und morgen
        const todayWid  = np[dateK].workout_id;
        const tomorrowWid = np[nextKey].workout_id;
        np[dateK]   = { ...np[dateK],   workout_id: tomorrowWid };
        np[nextKey] = { ...np[nextKey], workout_id: todayWid    };
        dbSaveDay(dateK,   np[dateK]);
        dbSaveDay(nextKey, np[nextKey]);
        return np;
      });
      toast('📅 Workout auf morgen verschoben!');
    }

    async function toggleSupplement(dateK, field) {
      const key = dateK + '_' + field;
      const nv  = !(supplements[key] || false);
      setSupplements(s => ({ ...s, [key]: nv }));
      await dbSaveSupplement(dateK, field, nv);
    }

    async function addCustomRecipe(recipe) {
      const nid = await dbSaveCustomRecipe(recipe);
      setCustomRecs(r => [...r, { ...recipe, id: nid, custom: true }]);
      toast('✅ Rezept gespeichert!');
    }
    async function deleteCustomRecipe(recipe) {
      if (recipe.supabase_id) await dbDeleteCustomRecipe(recipe.supabase_id);
      setCustomRecs(r => r.filter(x => x.id !== recipe.id));
      toast('🗑 Rezept gelöscht');
    }

    function applyBatch(dateK, meal, recipe) {
      setPlan(prev => {
        const np   = { ...prev };
        const days = Object.keys(np).sort();
        const idx  = days.indexOf(dateK);
        const n    = recipe.batchDays || 1;
        for (let i = 0; i < n && idx + i < days.length; i++) {
          const d = { ...np[days[idx + i]] }; d[meal] = recipe;
          np[days[idx + i]] = d; dbSaveDay(days[idx + i], d);
        }
        return np;
      });
      toast(`📦 "${recipe.name}" für ${recipe.batchDays || 1} Tage eingeplant!`);
    }

    const leftovers = useMemo(() => {
      const counts = {};
      weekDates(curWeek).forEach(d => {
        const day = plan[dk(d)]; if (!day) return;
        ['breakfast','lunch','dinner'].forEach(m => {
          day[m]?.ingredients.forEach(ing => {
            const base = ing.replace(/^\d[\d.,\s]*[gmlkgEL]+\s*/i,'').split('(')[0].trim().toLowerCase();
            if (base.length > 2) counts[base] = (counts[base] || 0) + 1;
          });
        });
      });
      return Object.entries(counts).filter(([,n]) => n === 1).map(([k]) => k).slice(0, 5);
    }, [plan, curWeek]);

    const shoppingList = useMemo(() => {
      const items = {};
      weekDates(shopWeek).forEach(d => {
        const day = plan[dk(d)]; if (!day) return;
        ['breakfast','lunch','dinner'].forEach(m => {
          day[m]?.ingredients.forEach(ing => {
            const norm = ing.trim().toLowerCase();
            items[norm] = (items[norm] || 0) + 1;
          });
        });
      });
      return Object.entries(items).sort((a,b) => a[0].localeCompare(b[0]));
    }, [plan, shopWeek]);

    const navItems = [
      { k:'dashboard', icon:'🏠', label:'Start'      },
      { k:'sport',     icon:'🏋️', label:'Sport'      },
      { k:'calendar',  icon:'📅', label:'Plan'       },
      { k:'shopping',  icon:'🛒', label:'Einkauf'    },
      { k:'health',    icon:'🩺', label:'Gesundheit' },
      { k:'recipes',   icon:'📖', label:'Rezepte'    },
    ];

    if (loading) return <LoadingScreen/>;

    const todayM       = dayMacros(todayKey);
    const todayDay     = plan[todayKey];
    const todayWorkout = todayDay ? WORKOUTS.find(w => w.id === todayDay.workout_id) || WORKOUTS.find(w => w.id === 'rest') : null;
    const workoutDone  = !!todayDay?.workout_done;
    // Aktivitäts-Bonus: verbannte Kalorien des heutigen Workouts (nur wenn erledigt)
    const activityBonus = (workoutDone && todayWorkout) ? todayWorkout.kcalBurn : 0;

    return (
      <div>
        <header className="app-header">
          <div className="logo-wrap">
            <div className="logo-dot">🥦</div>
            <div>
              <h1>VegeProtein</h1>
              <div className="tagline">Protein-Plus · Low-GI · PCOS-friendly</div>
            </div>
          </div>
          <nav className="desktop-nav">
            {navItems.map(({ k, icon, label }) => (
              <button key={k} className={tab === k ? 'active' : ''} onClick={() => setTab(k)}>
                {icon} {label}
              </button>
            ))}
          </nav>
        </header>

        <div className="main">
          {tab === 'dashboard' &&
            <Dashboard macros={macros} todayM={todayM} plan={plan} todayKey={todayKey}
                       toggleEaten={toggleEaten} supplements={supplements} toggleSupplement={toggleSupplement}
                       todayWorkout={todayWorkout} workoutDone={workoutDone} activityBonus={activityBonus}
                       toggleWorkoutDone={toggleWorkoutDone}/>}
          {tab === 'sport' &&
            <SportView plan={plan} sportWeek={sportWeek} setSportWeek={setSportWeek}
                       toggleWorkoutDone={toggleWorkoutDone} shiftWorkout={shiftWorkout} todayKey={todayKey}/>}
          {tab === 'calendar' &&
            <CalendarView plan={plan} updatePlanDay={updatePlanDay} curWeek={curWeek}
                          setCurWeek={setCurWeek} toggleEaten={toggleEaten} batchMode={batchMode}
                          setBatchMode={setBatchMode} applyBatch={applyBatch} allRecipes={allRecipes}
                          leftovers={leftovers} toast={toast} setModal={setModal}/>}
          {tab === 'shopping' &&
            <ShoppingView shoppingList={shoppingList} shopWeek={shopWeek} setShopWeek={setShopWeek} leftovers={leftovers}/>}
          {tab === 'health' &&
            <HealthView supplements={supplements} toggleSupplement={toggleSupplement}/>}
          {tab === 'recipes' &&
            <RecipesView customRecs={customRecs} allRecipes={allRecipes}
                         addCustomRecipe={addCustomRecipe} deleteCustomRecipe={deleteCustomRecipe} toast={toast}/>}
        </div>

        <nav className="bottom-nav" aria-label="Hauptnavigation">
          <div className="bottom-nav-inner">
            {navItems.map(({ k, icon, label }) => (
              <button key={k} type="button" className={tab === k ? 'active' : ''} onClick={() => setTab(k)}>
                <span className="nav-icon">{icon}</span>
                <span>{label}</span>
              </button>
            ))}
          </div>
        </nav>

        {modal && <MealModal modal={modal} onClose={() => setModal(null)} allRecipes={allRecipes}
                             updatePlanDay={updatePlanDay} batchMode={batchMode} applyBatch={applyBatch} toast={toast}/>}
        {snack  && <Snackbar msg={snack} onClose={() => setSnack(null)}/>}
      </div>
    );
  }

  // ── DASHBOARD ─────────────────────────────────────────────────────────────
  function Dashboard({ macros, todayM, plan, todayKey, toggleEaten, supplements, toggleSupplement,
                       todayWorkout, workoutDone, activityBonus, toggleWorkoutDone }) {
    const today     = new Date();
    const todayPlan = plan[todayKey];

    const wDays = Array.from({length:7}, (_, i) => {
      const d = new Date(today); const dow = d.getDay();
      d.setDate(d.getDate() - (dow === 0 ? 6 : dow - 1) + i); return dk(d);
    });
    const wEaten = wDays.reduce((a, k) => {
      const d = plan[k]; if (!d) return a;
      ['breakfast','lunch','dinner'].forEach(m => { if (d.eaten?.[m]) a++; });
      return a;
    }, 0);
    const wTotal = wDays.reduce((a, k) => a + (plan[k] ? 3 : 0), 0);

    // Effektives Kalorienziel = Grundziel + Aktivitäts-Bonus
    const effectiveKcal = macros.kcal + activityBonus;

    function SuppBtn({ field, label, icon }) {
      const key  = todayKey + '_' + field;
      const done = supplements[key] || false;
      return (
        <div className={`suppl-btn ${done ? 'done' : ''}`} onClick={() => toggleSupplement(todayKey, field)}>
          <div className={`check-box ${done ? 'checked' : ''}`}/>
          <div>
            <div style={{ fontWeight:500, fontSize:'.82rem' }}>{icon} {label}</div>
            <div style={{ fontSize:'.7rem', color:'var(--txt3)' }}>Täglich abhaken</div>
          </div>
        </div>
      );
    }

    return (
      <div>
        <div style={{ marginBottom:'1rem' }}>
          <h2 style={{ fontWeight:400, fontSize:'1.5rem' }}>Guten Tag! 💪</h2>
          <p style={{ color:'var(--txt3)', fontSize:'.86rem' }}>
            {today.toLocaleDateString('de-DE', { weekday:'long', day:'numeric', month:'long', year:'numeric' })}
          </p>
        </div>

        {/* Aktivitäts-Bonus Card */}
        {todayWorkout && (
          <div style={{ marginBottom:'.9rem' }}>
            <div className="activity-bonus">
              <div style={{ fontSize:'2rem', lineHeight:1 }}>
                {todayWorkout.id === 'rest' ? '😴' : '🏋️'}
              </div>
              <div style={{ flex:1 }}>
                <div style={{ fontWeight:600, fontSize:'.88rem', color:'var(--sport)' }}>
                  Heutiges Training: {todayWorkout.name}
                </div>
                <div style={{ fontSize:'.76rem', color:'var(--txt3)', marginTop:'2px' }}>
                  {workoutDone
                    ? `✅ Erledigt! +${activityBonus} kcal Aktivitäts-Bonus verrechnet`
                    : `🔥 ${todayWorkout.kcalBurn} kcal Bonus nach dem Training`}
                </div>
              </div>
              <div>
                <button type="button"
                        className={`btn btn-sm ${workoutDone ? 'btn-secondary' : 'btn-sport'}`}
                        onClick={() => toggleWorkoutDone(todayKey)}>
                  {workoutDone ? '↩ Rückgängig' : '✓ Fertig'}
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Makros – mit optionalem Bonus */}
        <div className="card">
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:'.85rem', flexWrap:'wrap', gap:'8px' }}>
            <div style={{ display:'flex', alignItems:'center', gap:'10px' }}>
              <div style={{ width:38, height:38, borderRadius:'50%', background:'var(--teal)', display:'flex', alignItems:'center', justifyContent:'center', color:'#fff', fontSize:'1.1rem', flexShrink:0 }}>♂</div>
              <div>
                <div style={{ fontWeight:600, fontSize:'.88rem' }}>Heutige Makros</div>
                <div style={{ fontSize:'.7rem', color:'var(--txt3)' }}>
                  Ziel {macros.kcal} kcal
                  {activityBonus > 0 && <span style={{ color:'var(--sport)', fontWeight:600 }}> +{activityBonus} Sport</span>}
                  {' '}= <strong>{effectiveKcal}</strong> kcal gesamt
                </div>
              </div>
            </div>
            <div style={{ display:'flex', gap:'4px', flexWrap:'wrap' }}>
              <span className="badge badge-teal">P {macros.pp}%</span>
              <span className="badge badge-blue">C {macros.cp}%</span>
              <span className="badge badge-amber">F {macros.fp}%</span>
              {activityBonus > 0 && <span className="badge badge-sport">🏋️ +{activityBonus}</span>}
            </div>
          </div>
          <ProgressBar label="Kalorien"      value={todayM.kcal}   max={effectiveKcal} unit=" kcal" color="var(--teal)"/>
          <ProgressBar label="Protein"       value={todayM.protein} max={macros.protein}             color="var(--teal)"/>
          <ProgressBar label="Kohlenhydrate" value={todayM.carbs}   max={macros.carbs}               color="var(--navy-l)"/>
          <ProgressBar label="Fett"          value={todayM.fat}     max={macros.fat}                 color="var(--amber)"/>
          <div style={{ marginTop:'.6rem', display:'flex', alignItems:'center', gap:'8px' }}>
            <div style={{ flex:1, height:6, background:'var(--cream2)', borderRadius:3, overflow:'hidden' }}>
              <div style={{ width:(wTotal > 0 ? wEaten/wTotal*100 : 0)+'%', height:'100%', background:'var(--green)', borderRadius:3, transition:'width .5s ease' }}/>
            </div>
            <span style={{ fontSize:'.72rem', color:'var(--txt3)', flexShrink:0 }}>Woche {wEaten}/{wTotal} ✓</span>
          </div>
